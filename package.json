{
  "name": "family-board",
  "version": "2.0.0",
  "private": true,
  "description": "Shared tasks, reminders, groceries and notes. A static web app; this file only holds development tools.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "serve": "python3 -m http.server 8765",
    "lint": "eslint .",
    "check:sw": "node tools/check-sw.mjs",
    "audit": "npm audit --audit-level=low",
    "test:rules": "firebase emulators:exec --only firestore --project fb-rules-test \"node tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project fb-rules-test \"node tests/e2e.mjs\"",
    "test:load": "firebase emulators:exec --only firestore --project fb-load-test \"node tests/load.mjs\"",
    "test:perf": "node tools/perf.js",
    "test": "npm run lint && npm run check:sw && npm run test:rules",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "^15.34.2",
    "globals": "^17.13.0",
    "playwright": "1.64.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "minimatch": "^11.0.3",
    "glob@>=9.0.0": "^14.0.3",
    "uuid": "^11.1.1",
    "re2": "^1.27.0",
    "@opentelemetry/core": "^2.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
