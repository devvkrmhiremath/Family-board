rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each board lives under families/{code}. The long random code acts as the
    // shared secret: only people who know it can read or write. Listing all
    // boards is not allowed, so codes can't be discovered.
    match /families/{familyId} {
      allow get, create, update: if familyId.size() >= 20;

      match /items/{itemId} {
        allow get, list, delete: if familyId.size() >= 20;
        allow create, update: if familyId.size() >= 20
          && request.resource.data.type in ['task', 'reminder', 'grocery', 'note']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }
  }
}
